MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATA_DIR=/srv/encit/data/moodle/prod/mariadb

MOODLE_CONFIG_DIR=/srv/encit/data/moodle/prod/config
MOODLEDATA_DIR=/srv/encit/data/moodle/prod/moodledata

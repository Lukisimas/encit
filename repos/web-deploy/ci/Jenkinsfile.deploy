pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    string(name:'FRONTEND_TAG', defaultValue:'', description:'DEV/TEST: tag de frontend ya construido')
    string(name:'BACKEND_TAG', defaultValue:'', description:'DEV/TEST: tag de backend ya construido')
    string(name:'FRONTEND_TESTED_TAG', defaultValue:'', description:'PROD: tag frontend terminado en -tested')
    string(name:'BACKEND_TESTED_TAG', defaultValue:'', description:'PROD: tag backend terminado en -tested')
  }
  environment {
    REGISTRY='git.infra.encit.unam.mx'
    FRONT_IMAGE="${REGISTRY}/encit/web-frontend"
    BACK_IMAGE="${REGISTRY}/encit/web-backend"
  }
  stages {
    stage('Validate non-prod tags'){
      when{not{branch 'main'}}
      steps{sh 'test -n "$FRONTEND_TAG" && test -n "$BACKEND_TAG"'}
    }

    stage('DEV'){
      when{branch 'develop'}
      steps{sshagent(credentials:['control-deploy-ssh']){
        sh '''
          ssh deploy@10.10.10.20 "
            cd /srv/encit/apps/web/dev &&
            sed -i 's/^FRONTEND_TAG=.*/FRONTEND_TAG=${FRONTEND_TAG}/' .env &&
            sed -i 's/^BACKEND_TAG=.*/BACKEND_TAG=${BACKEND_TAG}/' .env &&
            docker compose pull && docker compose up -d --remove-orphans
          "
        '''
      }}
    }

    stage('TEST'){
      when{expression{env.BRANCH_NAME==~ /^release\/.*/}}
      steps{
        sshagent(credentials:['control-deploy-ssh']){
          sh '''
            ssh deploy@10.10.10.20 "
              cd /srv/encit/apps/web/test &&
              sed -i 's/^FRONTEND_TAG=.*/FRONTEND_TAG=${FRONTEND_TAG}/' .env &&
              sed -i 's/^BACKEND_TAG=.*/BACKEND_TAG=${BACKEND_TAG}/' .env &&
              docker compose pull && docker compose up -d --remove-orphans
            "
          '''
        }
        sh 'curl -fsS --retry 10 https://web.test.encit.unam.mx/'
      }
    }

    stage('Mark both TESTED'){
      when{expression{env.BRANCH_NAME==~ /^release\/.*/}}
      steps{
        withCredentials([usernamePassword(credentialsId:'gitea-registry',usernameVariable:'U',passwordVariable:'P')]){
          sh '''
            echo "$P"|docker login "$REGISTRY" -u "$U" --password-stdin
            docker pull "$FRONT_IMAGE:$FRONTEND_TAG"
            docker tag "$FRONT_IMAGE:$FRONTEND_TAG" "$FRONT_IMAGE:${FRONTEND_TAG}-tested"
            docker push "$FRONT_IMAGE:${FRONTEND_TAG}-tested"

            docker pull "$BACK_IMAGE:$BACKEND_TAG"
            docker tag "$BACK_IMAGE:$BACKEND_TAG" "$BACK_IMAGE:${BACKEND_TAG}-tested"
            docker push "$BACK_IMAGE:${BACKEND_TAG}-tested"
          '''
        }
      }
    }

    stage('Validate PROD tags'){
      when{branch 'main'}
      steps{
        sh '''
          test -n "$FRONTEND_TESTED_TAG" && test -n "$BACKEND_TESTED_TAG"
          case "$FRONTEND_TESTED_TAG" in *-tested) ;; *) exit 2;; esac
          case "$BACKEND_TESTED_TAG" in *-tested) ;; *) exit 2;; esac
        '''
      }
    }

    stage('Approve PROD'){
      when{branch 'main'}
      steps{input message:'¿Respaldar y desplegar exactamente frontend/backend TESTED?'}
    }

    stage('PROD'){
      when{branch 'main'}
      steps{sshagent(credentials:['production-deploy-ssh']){
        sh '''
          ssh deploy@10.10.10.30 "
            set -e; cd /srv/encit/apps/web/prod
            set -a; . ./.env; set +a
            export BACKUP_DIR=/srv/encit/backups/web/prod
            ./scripts/backup.sh
            sed -i 's/^FRONTEND_TAG=.*/FRONTEND_TAG=${FRONTEND_TESTED_TAG}/' .env
            sed -i 's/^BACKEND_TAG=.*/BACKEND_TAG=${BACKEND_TESTED_TAG}/' .env
            docker compose pull && docker compose up -d --remove-orphans
          "
        '''
      }}
    }
  }
}

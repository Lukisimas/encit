ENV_NAME=prod
EDGE_NETWORK=encit_prod_edge
EDGE_ALIAS=web-prod-gateway
PUBLIC_BASE_URL=https://encit.unam.mx

REGISTRY=git.infra.encit.unam.mx
FRONTEND_TAG=REPLACE_WITH_IMAGE_TAG
BACKEND_TAG=REPLACE_WITH_IMAGE_TAG
MICROSITES_TAG=legacy

# Mantener MySQL 8.2.0 inicialmente.
MYSQL_DATABASE=encit
MYSQL_USER=encit
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATA_DIR=/srv/encit/data/web/prod/mysql
SQL_INIT_DIR=/srv/encit/config/web/sql-scripts

# IMPORTANTE: sustituir tras inventario. Ejemplo válido sólo cuando se haya probado: redis:7.x.y
REDIS_IMAGE=REPLACE_WITH_VALIDATED_REDIS_VERSION
REDIS_PASSWORD=CHANGE_ME
REDIS_APP_DATA_DIR=/srv/encit/data/web/prod/redis-app
REDIS_LOCAL_DATA_DIR=/srv/encit/data/web/prod/redis-local

UPLOADS_DIR=/srv/encit/data/web/prod/uploads
BACKEND_LOGS_DIR=/srv/encit/data/web/prod/logs
FILES_HOST_DIR=/srv/encit/data/web/shared-files
SITES_HOST_DIR=/srv/encit/data/web/legacy-sites

SECRET_KEY=CHANGE_ME
MAIL_ADDRESS=CHANGE_ME
MAIL_SENDER=CHANGE_ME
MAIL_KEY=CHANGE_ME
